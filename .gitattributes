# Normalise line endings so the repo is consistent across Windows, macOS and Linux.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.mp3 binary
*.mp4 binary

# Generated; keep it out of diffs and language stats.
package-lock.json -diff linguist-generated
