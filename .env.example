# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Storage
STORAGE_DIR=./storage
# Max upload size per file, in megabytes
MAX_FILE_SIZE_MB=200
# Max files per upload batch
MAX_FILES_PER_BATCH=20
# How long converted files are kept before automatic deletion (minutes)
FILE_TTL_MINUTES=60
# How often the cleanup sweeper runs (minutes)
CLEANUP_INTERVAL_MINUTES=5

# Queue
QUEUE_CONCURRENCY=2

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_UPLOADS=100
RATE_LIMIT_MAX_REQUESTS=1000

# Optional: TrueType font embedded in generated PDFs.
# The built-in PDF fonts only cover Latin-1, so scripts such as Khmer, Thai, or
# CJK need a font that actually contains their glyphs. A broad system font
# (Arial, Segoe UI, DejaVu Sans) is detected automatically when present; set
# these to override it.
#   Khmer on Windows:  PDF_FONT_PATH=C:/Windows/Fonts/KhmerOS.ttf
#   Khmer (alt faces): KhmerOSbattambang.ttf, KhmerOScontent.ttf, KhmerOSmuol.ttf
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# Optional: absolute path to a LibreOffice `soffice` binary.
# When present, Office conversions (DOC, PPT, XLS, RTF, ODT -> PDF) are enabled.
# Leave empty to auto-detect; conversions stay hidden in the UI if not found.
LIBREOFFICE_PATH=

# ---- Web (Vite) ----
# Not needed for normal use. The dev server proxies /api to the API process, and
# production serves both from one origin. Set this only when the client is
# deployed separately from the API (and add that origin to CORS_ORIGIN above).
# VITE_API_URL=https://api.example.com
